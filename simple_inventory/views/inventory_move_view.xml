<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_inventory_move_list" model="ir.ui.view">
        <field name="name">inventory.move.list</field>
        <field name="model">inventory.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="product_id" />
                <field name="product_code" />
                <field name="move_type" />
                <field name="quantity" />
                <field name="note" />
            </list>
        </field>
    </record>

    <record id="view_inventory_move_form" model="ir.ui.view">
        <field name="name">inventory.move.form</field>
        <field name="model">inventory.move</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_duplicate_as_in" type="object" string="Duplicate as Stock In" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="move_type" />
                        <field name="quantity" />
                        <field name="date" />
                        <field name="note" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inventory_move" model="ir.actions.act_window">
        <field name="name">Stock Moves</field>
        <field name="res_model">inventory.move</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>